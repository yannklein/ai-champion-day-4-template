# Copy this file to .env.local and fill in the values from the deployment
# details your trainer gave you. The names come first: if the handout uses
# different ones, the handout wins.
#
# .env.local is never committed. This file is its twin: same names, no values.

# Your own Convex deployment. The CLI uses these to push functions.
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=

# The same deployment, read by the browser. Compiled into the app AT BUILD
# TIME, so anything with a VITE_ prefix is public once the app is built.
VITE_CONVEX_URL=
